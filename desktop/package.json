{
  "name": "lantern-desktop",
  "version": "1.0.10",
  "description": "Lantern browser with Daily Bible Verse",
  "main": "main.js",
  "author": "Lantern",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.lantern.browser",
    "productName": "Lantern",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Lantern-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
