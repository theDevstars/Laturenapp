{
  "expo": {
    "name": "Saturn",
    "slug": "saturn",
    "version": "1.0.10",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.lantern",
      "buildNumber": "10"
    },
    "android": {
      "package": "com.yourname.lantern",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "http"
            },
            {
              "scheme": "https"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 10
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a wallpaper for Lantern."
        }
      ]
    ]
  }
}
